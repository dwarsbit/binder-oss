{
  "name": "@scholarkit/binder",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "vite build && vite build --mode web",
    "build:desktop": "vite build",
    "build:web": "vite build --mode web",
    "build:clipper": "vite build -c clipper/vite.config.ts && vite build -c clipper/vite.config.content.ts && vite build -c clipper/vite.config.background.ts && node clipper/scripts/pack.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc && tsc -p clipper/tsconfig.json",
    "test": "vitest run",
    "i18n": "scholarkit-i18n extract src clipper/src node_modules/@scholarkit/editor/src node_modules/@scholarkit/updates/src node_modules/@scholarkit/account-menu/src src/locales",
    "lint:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "prepare": "pnpm --filter @scholarkit/contracts --filter @scholarkit/i18n --filter @scholarkit/monitoring build"
  },
  "dependencies": {
    "@scholarkit/account-menu": "workspace:*",
    "@scholarkit/contracts": "workspace:*",
    "@scholarkit/editor": "workspace:*",
    "@scholarkit/i18n": "workspace:*",
    "@scholarkit/monitoring": "workspace:*",
    "@scholarkit/updates": "workspace:*",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tiptap/core": "^3.33.1",
    "@tiptap/react": "^3.33.0",
    "fflate": "catalog:",
    "lucide-react": "^1.71.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@scholarkit/eslint-config": "workspace:*",
    "@scholarkit/tsconfig": "workspace:*",
    "@sentry/vite-plugin": "catalog:",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@types/chrome": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "tailwindcss": "^4.3.5",
    "typescript": "catalog:",
    "vite": "^8.3.7",
    "vitest": "catalog:"
  }
}
