{
	admin off
	auto_https off
}

# The port can be moved: on a host where the containers share one
# network address, the Polemic editor's image already listens on 80.
:{$PORT:80} {
	root * /srv
	encode zstd gzip

	# Scripts only from the app's own files: the page shares its origin with the signed-in
	# account, so text from a binder must never run as script here.
	header Content-Security-Policy "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"

	# Tesseract's language files, for recognizing the text of scans. The desktop app and the
	# demo fetch them from another origin.
	handle /binder/tessdata/* {
		header Access-Control-Allow-Origin "*"
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# Vite puts a content hash in these file names.
	handle /binder/assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Every other path under /binder is the app (/binder/<id> opens a binder).
	@app path /binder /binder/*
	handle @app {
		header Cache-Control "no-cache"
		try_files {path} /binder/index.html
		file_server
	}

	# Nothing else is served here: /api and the rest belong to the server's
	# own proxy, and a request that reaches this container by mistake gets
	# a 404 rather than the app's page.
	handle {
		respond 404
	}
}
